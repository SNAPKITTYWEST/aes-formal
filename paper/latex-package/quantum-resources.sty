      \midrule
      Shor (RSA-2048)      & \QubitCount{shor}{2048}   & \TGateCount{shor}{2048}   & \TDepthCount{shor}{2048}   \\
      Shor (RSA-3072)      & \QubitCount{shor}{3072}   & \TGateCount{shor}{3072}   & \TDepthCount{shor}{3072}   \\
      Grover (AES-128)     & \QubitCount{grover}{128}  & \TGateCount{grover}{128}  & \TDepthCount{grover}{128}  \\
